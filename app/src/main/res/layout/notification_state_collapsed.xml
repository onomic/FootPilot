<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notification_panel"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="1dp"
    android:paddingEnd="12dp"
    android:paddingBottom="1dp">

    <TextView
        android:id="@+id/notification_collapsed_battery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F1F5F4"
        android:textSize="17sp"
        android:textStyle="bold"
        tools:text="Battery 93%" />

    <TextView
        android:id="@+id/notification_collapsed_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#C8D1CF"
        android:textSize="12sp"
        tools:text="Standby off · Running shoes · +1.8°" />
</LinearLayout>
