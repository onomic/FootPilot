<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notification_expanded_battery_label"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Battery" />

        <TextView
            android:id="@+id/notification_expanded_battery_value"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#34E0A1"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="93%" />
    </LinearLayout>

    <TextView
        android:id="@+id/notification_expanded_standby"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textSize="15sp"
        tools:text="Standby off" />

    <LinearLayout
        android:id="@+id/notification_angle_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notification_summary_image"
            android:layout_width="42dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/ankle_preset_artwork"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notification_summary_name"
                style="@style/TextAppearance.Compat.Notification.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="14sp"
                tools:text="Running shoes" />

            <TextView
                android:id="@+id/notification_angle_text"
                style="@style/TextAppearance.Compat.Notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="14sp"
                tools:text="Confirmed +1.8°" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/notification_operation_status"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#F5B94A"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Applying preset..." />

    <LinearLayout
        android:id="@+id/notification_preset_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:weightSum="4">

        <LinearLayout
            android:id="@+id/notification_preset_barefoot"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/notification_preset_disabled"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">

            <ImageView
                android:id="@+id/notification_preset_barefoot_image"
                android:layout_width="42dp"
                android:layout_height="34dp"
                android:contentDescription="@string/preset_barefoot"
                android:scaleType="centerCrop"
                android:src="@drawable/preset_barefoot" />

            <TextView
                android:id="@+id/notification_preset_barefoot_label"
                style="@style/TextAppearance.Compat.Notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/preset_barefoot"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notification_preset_running"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/notification_preset_disabled"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">

            <ImageView
                android:id="@+id/notification_preset_running_image"
                android:layout_width="42dp"
                android:layout_height="34dp"
                android:contentDescription="@string/preset_running"
                android:scaleType="centerCrop"
                android:src="@drawable/preset_running" />

            <TextView
                android:id="@+id/notification_preset_running_label"
                style="@style/TextAppearance.Compat.Notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/preset_running"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notification_preset_dress"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/notification_preset_disabled"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">

            <ImageView
                android:id="@+id/notification_preset_dress_image"
                android:layout_width="42dp"
                android:layout_height="34dp"
                android:contentDescription="@string/preset_dress"
                android:scaleType="centerCrop"
                android:src="@drawable/preset_dress" />

            <TextView
                android:id="@+id/notification_preset_dress_label"
                style="@style/TextAppearance.Compat.Notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/preset_dress"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notification_preset_boots"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/notification_preset_disabled"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">

            <ImageView
                android:id="@+id/notification_preset_boots_image"
                android:layout_width="42dp"
                android:layout_height="34dp"
                android:contentDescription="@string/preset_boots"
                android:scaleType="centerCrop"
                android:src="@drawable/preset_boots" />

            <TextView
                android:id="@+id/notification_preset_boots_label"
                style="@style/TextAppearance.Compat.Notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/preset_boots"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
